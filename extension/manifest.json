{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "CozyNode",
  "description": "__MSG_extDescription__",
  "version": "0.2.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CozyNode",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "proxy",
    "storage",
    "privacy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}
